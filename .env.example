# ==============================================================================
# Transaction Fraud Scorer Agentic AI - Environment Configuration
# ==============================================================================

# Local Ollama Configuration (Default local model provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Heterogeneous Model Tiering (PRD-017 & PRD-019)
DATA_RETRIEVAL_MODEL=llama3.2:3b
ANALYSIS_MODEL=llama3.1:8b
DECISION_MODEL=llama3.1:8b
EVALUATOR_MODEL=llama3.1:8b

# LLM Provider: "ollama" (for live local/Colab model) or "mock" (offline test fallback)
DEFAULT_LLM_PROVIDER=ollama

# LangSmith Observability & Distributed Tracing (PRD-018)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fraud-scorer-agentic-ai
LANGSMITH_MASK_PII=true
LANGSMITH_SAMPLE_RATE=1.0

# Optional OpenTelemetry Collector Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional Cloud LLM Keys (fallback or comparison)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# MCP Server Settings
MCP_SERVER_TRANSPORT=stdio          # stdio | sse
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# API Gateway & Network Settings
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
ENABLE_CLOUDFLARE_TUNNEL=false

# SQLite RDBMS & Policy Defaults
SQLITE_DB_PATH=src/sqllite/fraud_scorer.db
DEFAULT_POLICY_YEAR=2026

# Application Logging & Environment
LOG_LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR
ENVIRONMENT=development             # development, staging, production
