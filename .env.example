# ==============================================================================
# Transaction Fraud Scorer Agentic AI - Environment Configuration
# ==============================================================================

# LLM Provider API Keys (Configure the one you intend to use)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default LLM Provider: "gemini", "anthropic", "openai", or "mock" (for offline testing)
DEFAULT_LLM_PROVIDER=mock

# MCP Server Settings
MCP_SERVER_TRANSPORT=stdio          # stdio | sse
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# Application Logging & Environment
LOG_LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR
ENVIRONMENT=development             # development, staging, production
